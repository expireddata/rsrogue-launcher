<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss:SSS}
			[%highlight{%level}{FATAL=bg_red, ERROR=red, WARN=yellow, INFO=green, DEBUG=blue, TRACE=magenta}]
			[%thread]: %logger{1}.%M:%L - %msg%n"
				disableAnsi="false"/>
		</Console>
		<!-- rsrogue: the installed exe has no console, so the launcher also logs to a file -->
		<File name="File" fileName="${sys:user.home}/.rsrogue/logs/launcher.log" append="true">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss:SSS} [%level] [%thread]: %logger{1}.%M:%L - %msg%n"/>
		</File>
	</Appenders>
	<Loggers>
		<Root level="debug">
			<AppenderRef level="all" ref="Console"/>
			<AppenderRef level="info" ref="File"/>
		</Root>
		<logger name="io.netty" level="info"/>
		<Logger name="org.openrs2.compress" level="warn" additivity="false"/>
	</Loggers>
</Configuration>
